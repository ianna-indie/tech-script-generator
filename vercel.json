{
  "functions": {
    "api/claude.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/b/:id", "destination": "/brief.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ]}
  ]
}
